import math

# Константа Кнута для методу множення
A = (math.sqrt(5) - 1) / 2

# Список вхідних слів 
WORDS = [
    "НЕ", "ПИТАЙ", "БРОДУ", "КОЛИ", "ЙДЕШ", "У", "ВОДУ", "І",
    "НЕ", "ПИТАЙ", "ПРАВДИ", "В", "ТОГО", "ХТО", "БРЕХНЕЮ", "ЖИВЕ"
]

# Словник позицій українських літер (згідно з Рис. 4.3)
LETTER_POSITIONS = {
    'А': 1, 'Б': 2, 'В': 3, 'Г': 4, 'Ґ': 5, 'Д': 6, 'Е': 7, 'Є': 8,
    'Ж': 9, 'З': 10, 'И': 11, 'І': 12, 'Ї': 13, 'Й': 14, 'К': 15, 'Л': 16,
    'М': 17, 'Н': 18, 'О': 19, 'П': 20, 'Р': 21, 'С': 22, 'Т': 23, 'У': 24,
    'Ф': 25, 'Х': 26, 'Ц': 27, 'Ч': 28, 'Ш': 29, 'Щ': 30, 'Ь': 31, 'Ю': 32, 'Я': 33
}

def get_key_sum(key: str) -> int:
    """Обчислює суму позицій букв слова."""
    sum_of_positions = 0
    for char in key.upper():
        position = LETTER_POSITIONS.get(char, 0)
        sum_of_positions += position
    return sum_of_positions

def division_hash(key: str, m: int = 13) -> int:
    """h(k) = (сума позицій букв) mod M. Первинна хеш-функція ділення."""
    return get_key_sum(key) % m

def multiplication_hash(key: str, m: int = 16) -> int:
    """h(k) = floor(M * (k * A mod 1)). Первинна хеш-функція множення."""
    k = get_key_sum(key)
    return math.floor(m * ((k * A) % 1))

def build_closed_hash_table(words: list, m: int, primary_hash_func) -> list:
    """
    Будує хеш-таблицю з відкритою адресацією,
    використовуючи лінійне дослідження.
    """
    # 1. Ініціалізація таблиці: M порожніх слотів (використовуємо None як "порожній")
    hash_table = [None] * m
    inserted_count = 0

    # 2. Обробка кожного слова
    for word in words:
        # Крок 2а: Обчислення початкової адреси
        start_address = primary_hash_func(word, m)
        address = start_address

        # Крок 2б: Лінійне дослідження (Linear Probing)
        # Цикл гарантує, що ми не будемо шукати нескінченно довго у повній таблиці
        for i in range(m):
            # h(k, i) = (h(k) + i) mod M
            address = (start_address + i) % m

            # Перевірка, чи комірка вільна
            if hash_table[address] is None:
                # Вставлення ключа
                hash_table[address] = word
                inserted_count += 1
                break
            # Якщо комірка зайнята, продовжуємо цикл (наступна ітерація i збільшить крок на 1)
        else:
            # Цей блок виконується, якщо цикл завершився без 'break' (таблиця повна)
            print(f"Помилка: Таблиця заповнена. Не вдалося додати слово: {word}")

    return hash_table

def display_hash_table(table: list, title: str):
    """Виводить хеш-таблицю у зручному форматі (за зразком Таблиці 4.5)."""
    print(f"\n--- {title} (Відкрита адресація, M={len(table)}) ---")
    print("Індекс | Слово")
    print("--------------------")
    for i, item in enumerate(table):
        # Виводимо ключі або позначку, що комірка порожня
        value = item if item is not None else "(NULL)"
        print(f"{i:02d}     | {value}")

# Виконання для методу ділення (M = 13)
closed_table_div = build_closed_hash_table(WORDS, 13, division_hash)
display_hash_table(closed_table_div, "Хеш-таблиця: Метод ділення")

# Виконання для методу множення (M = 16)
closed_table_mult = build_closed_hash_table(WORDS, 16, multiplication_hash)
display_hash_table(closed_table_mult, "Хеш-таблиця: Метод множення")
